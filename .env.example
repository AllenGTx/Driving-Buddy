# Prioritas otomatis (jika diisi lebih dari satu, server otomatis failover):
# 1. FreeLLMAPI lokal (http://127.0.0.1:3001/v1) -> 2. Groq -> 3. Gemini -> 4. Cerebras
FREELLM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Atau konfigurasi tunggal manual:
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...

# Endpoint Voicebox lokal untuk suara kloning Furina (default http://127.0.0.1:17493)
VOICEBOX_URL=http://127.0.0.1:17493
# Opsional: URL Cloud Furina TTS jika di-deploy terpisah
FURINA_TTS_URL=
